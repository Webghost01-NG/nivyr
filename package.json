{
  "name": "nivyr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Experimental TypeScript controls for real shielded Zcash payment lifecycles",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "merchant": "node --experimental-strip-types examples/merchant/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/packages/test/src/index.d.ts",
      "import": "./dist/packages/test/src/index.js"
    }
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.23.1"
  }
}
